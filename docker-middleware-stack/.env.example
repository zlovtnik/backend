# Middleware Stack Environment Configuration
# Copy this file to .env and update values as needed

# PostgreSQL Configuration
POSTGRES_DB=middleware
POSTGRES_USER=middleware
POSTGRES_PASSWORD=middleware123
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak123
APP_DB=app
APP_DB_USER=app_user
APP_DB_PASSWORD=app123
ANALYTICS_DB=analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics123

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_MIDDLEWARE_APP_SECRET=middleware-app-secret-dev

# Redis Configuration
# For development, use a simple password; for production, use a strong, randomly generated secret
REDIS_PASSWORD=redis-devpassword-123
REDIS_MAXMEMORY=256mb

# MinIO Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_DOMAIN=localhost

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,PLAINTEXT_INTERNAL://kafka:9093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,PLAINTEXT_INTERNAL://0.0.0.0:9093

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_USERS_ALLOW_SIGN_UP=false

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=middleware-stack
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Service Ports (can be changed if conflicts)
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KEYCLOAK_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_PORT=16686
OTEL_COLLECTOR_PORT=4317
KAFKA_UI_PORT=8082
REDIS_COMMANDER_PORT=8083
PGADMIN_PORT=5050

# Development/Production Mode
ENVIRONMENT=development
DEBUG=true

# Resource Limits (adjust based on your system)
POSTGRES_MEMORY=512m
REDIS_MEMORY=256m
KAFKA_MEMORY=1g
KEYCLOAK_MEMORY=1g
MINIO_MEMORY=512m
GRAFANA_MEMORY=256m
PROMETHEUS_MEMORY=256m
JAEGER_MEMORY=512m
OTEL_COLLECTOR_MEMORY=512m
