# Kafka Broker Configuration
# Production-grade environment variables for Kafka Docker container
# Source this file with: docker compose --env-file .env.kafka up

# =================================================================================
# BASIC BROKER CONFIGURATION
# =================================================================================

# Unique broker identifier in the Kafka cluster
KAFKA_BROKER_ID=1

# =================================================================================
# NETWORK & LISTENER CONFIGURATION
# =================================================================================

# Security protocol mapping (PLAINTEXT, SSL, SASL_PLAINTEXT, SASL_SSL)
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT

# Advertised listeners (accessible from different networks)
# Format: PLAINTEXT://internal-host:port,PLAINTEXT_HOST://external-host:port
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092

# =================================================================================
# TOPIC & REPLICATION SETTINGS
# =================================================================================

# Replication factor for offset topic (minimum 1, recommended >=2 for production)
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Minimum in-sync replicas for transaction state log
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# Replication factor for transaction state log
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1

# Delay (ms) before first rebalance in a consumer group
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# Automatically create topics when they don't exist
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Allow deletion of topics (set to false in production if preferred)
KAFKA_DELETE_TOPIC_ENABLE=true

# =================================================================================
# LOG RETENTION & CLEANUP
# =================================================================================

# How long to keep log segments (hours)
KAFKA_LOG_RETENTION_HOURS=168

# Maximum size of a log segment file (bytes) - Default 1GB
KAFKA_LOG_SEGMENT_BYTES=1073741824

# Log cleanup policy: delete (time-based) or compact (key-based)
KAFKA_LOG_CLEANUP_POLICY=delete

# =================================================================================
# PERFORMANCE TUNING
# =================================================================================

# Number of network threads for handling client requests
KAFKA_NUM_NETWORK_THREADS=8

# Number of I/O threads for processing disk operations
KAFKA_NUM_IO_THREADS=8

# Size of send buffer for network connections (bytes)
KAFKA_SOCKET_SEND_BUFFER_BYTES=102400

# Size of receive buffer for network connections (bytes)
KAFKA_SOCKET_RECEIVE_BUFFER_BYTES=102400

# Maximum size of requests from a client (bytes) - 100MB
KAFKA_SOCKET_REQUEST_MAX_BYTES=104857600

# Number of replica fetchers for replication
KAFKA_NUM_REPLICA_FETCHERS=4

# Size of socket receive buffer for replication (bytes)
KAFKA_REPLICA_SOCKET_RECEIVE_BUFFER_BYTES=65536

# Maximum time (ms) between leader and follower before replicas are considered out of sync
KAFKA_REPLICA_LAG_TIME_MAX_MS=30000

# Time (ms) before idle connections are closed
KAFKA_CONNECTIONS_MAX_IDLE_MS=540000

# =================================================================================
# ZOOKEEPER CONFIGURATION
# =================================================================================

# Zookeeper connection string (host:port,host:port)
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# Zookeeper session timeout (ms)
KAFKA_ZOOKEEPER_SESSION_TIMEOUT_MS=18000

# =================================================================================
# JVM & MEMORY SETTINGS
# =================================================================================

# JVM heap memory allocation (min and max)
KAFKA_HEAP_OPTS=-Xms1G -Xmx1G

# JVM performance optimization (G1GC for better pause times)
KAFKA_JVM_PERFORMANCE_OPTS=-XX:+UseG1GC -XX:MaxGCPauseMillis=20 -XX:InitiatingHeapOccupancyPercent=35 -XX:+DisableExplicitGC

# =================================================================================
# METRICS & MONITORING
# =================================================================================

# Number of samples to keep for metrics
KAFKA_METRICS_NUM_SAMPLES=3

# Time window (ms) for metric samples
KAFKA_METRICS_SAMPLE_WINDOW_MS=30000

# JMX monitoring port
KAFKA_JMX_PORT=9999

# =================================================================================
# JMX SECURITY CONFIGURATION
# =================================================================================

# Enable secure JMX (authentication + SSL) - true for production, false for development only
JMX_SECURE=true

# Keystore password for JMX SSL
KEYSTORE_PASSWORD=changeit

# Truststore password for JMX SSL
TRUSTSTORE_PASSWORD=changeit

# =================================================================================
# NOTES FOR PRODUCTION
# =================================================================================
# 1. Set JMX_SECURE=true in production
# 2. Use strong passwords for KEYSTORE_PASSWORD and TRUSTSTORE_PASSWORD
# 3. Increase KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR to at least 2-3
# 4. Adjust KAFKA_LOG_RETENTION_HOURS based on your retention policy
# 5. Monitor KAFKA_NUM_NETWORK_THREADS and KAFKA_NUM_IO_THREADS for your workload
# 6. Use mounted secrets for sensitive data (jmxremote.password, keystores, etc.)
# 7. Recommended heap size: at least 2G for production (modify KAFKA_HEAP_OPTS)
