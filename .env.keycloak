# Keycloak Configuration
# Production-grade environment variables for Keycloak Docker container
# Source this file with: docker compose --env-file .env.keycloak up
# NOTE: Database configuration (KC_DB_*) is excluded - configure separately in .env.db or docker-compose.yml

# =================================================================================
# BASIC KEYCLOAK CONFIGURATION
# =================================================================================

# Keycloak installation directory
KEYCLOAK_HOME=/opt/keycloak

# Initial admin username (set on first startup only)
KEYCLOAK_ADMIN=admin

# Initial admin password (set on first startup only) - CHANGE THIS IN PRODUCTION
KEYCLOAK_ADMIN_PASSWORD=changeme

# =================================================================================
# HOSTNAME & PROXY CONFIGURATION
# =================================================================================

# Hostname used for issuing tokens and in URLs (must match client redirect URIs)
KC_HOSTNAME=localhost

# Proxy configuration: edge (behind proxy), reencrypt (HTTPS termination), or passthrough
KC_PROXY=edge

# Frontend URL (optional, overrides hostname for frontend display)
KC_FRONTEND_URL=http://localhost:8080

# =================================================================================
# HTTPS & TLS CONFIGURATION
# =================================================================================

# HTTPS enabled (requires KC_HTTPS_KEY_STORE_* configuration)
KC_HTTPS_ENABLED=false

# Path to HTTPS keystore file (JKS format) - only if KC_HTTPS_ENABLED=true
# KC_HTTPS_KEY_STORE_FILE=/etc/keycloak/secrets/keycloak.server.keystore.jks

# Keystore password for HTTPS (only if KC_HTTPS_ENABLED=true)
# KC_HTTPS_KEY_STORE_PASSWORD=changeit

# Keystore type (JKS or PKCS12)
# KC_HTTPS_KEY_STORE_TYPE=JKS

# Certificate alias in keystore
# KC_HTTPS_CERTIFICATE_ALIAS=keycloak

# Trust store for client certificate validation (optional)
# KC_HTTPS_TRUST_STORE_FILE=/etc/keycloak/secrets/keycloak.server.truststore.jks

# Trust store password
# KC_HTTPS_TRUST_STORE_PASSWORD=changeit

# Trust store type
# KC_HTTPS_TRUST_STORE_TYPE=JKS

# =================================================================================
# FEATURES & FUNCTIONALITY
# =================================================================================

# Enable/disable specific features (comma-separated)
# Common features: preview (experimental), recovery_codes, scripts, web_authn, etc.
KC_FEATURES=

# Enable account API for account management
KC_ACCOUNT_API_ENABLED=true

# =================================================================================
# REALM & USER CONFIGURATION
# =================================================================================

# Default realm name
KC_REALM_NAME=master

# Create initial admin user (only on first start)
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=changeme

# =================================================================================
# LOGGING CONFIGURATION
# =================================================================================

# Log level (FATAL, ERROR, WARN, INFO, DEBUG, TRACE)
KC_LOG_LEVEL=INFO

# Log format (json or default)
KC_LOG_FORMAT=default

# =================================================================================
# AUTHENTICATION & SESSION CONFIGURATION
# =================================================================================

# Session timeout (minutes)
KC_SESSION_TIMEOUT_MINUTES=30

# Remember me session timeout (minutes)
KC_REMEMBER_ME_TIMEOUT_MINUTES=10080

# Offline session timeout (minutes)
KC_OFFLINE_SESSION_TIMEOUT_MINUTES=2592000

# Action token timeout (minutes) - for email verification, password reset, etc.
KC_ACTION_TOKEN_TIMEOUT_MINUTES=5

# Access token lifespan (minutes)
KC_ACCESS_TOKEN_LIFESPAN_MINUTES=5

# Refresh token lifespan (minutes)
KC_REFRESH_TOKEN_LIFESPAN_MINUTES=30

# Idle session timeout (minutes)
KC_IDLE_SESSION_TIMEOUT_MINUTES=30

# Idle reminder timeout (minutes)
KC_IDLE_REMINDER_TIMEOUT_MINUTES=1

# =================================================================================
# CACHE CONFIGURATION
# =================================================================================

# Cache type (ispn for clustering, local for single instance)
KC_CACHE=local

# Lock provider for distributed caching
KC_CACHE_CONFIG_FILE=cache-ispn-jdbc-ping.xml

# =================================================================================
# JVM & MEMORY SETTINGS
# =================================================================================

# JVM heap memory (minimum and maximum)
JAVA_OPTS_APPEND=-Xms1G -Xmx1G -XX:+UseG1GC -XX:MaxGCPauseMillis=20 -XX:InitiatingHeapOccupancyPercent=35 -XX:+DisableExplicitGC

# =================================================================================
# SMTP & EMAIL CONFIGURATION
# =================================================================================

# SMTP server host
KC_SPI_SMTP_HOST=localhost

# SMTP server port
KC_SPI_SMTP_PORT=587

# SMTP username (if authentication required)
KC_SPI_SMTP_USERNAME=

# SMTP password (if authentication required)
KC_SPI_SMTP_PASSWORD=

# From address for emails
KC_SPI_SMTP_FROM=noreply@example.com

# From display name
KC_SPI_SMTP_FROM_DISPLAY_NAME=Keycloak

# Enable STARTTLS for SMTP
KC_SPI_SMTP_STARTTLS=true

# Enable SSL/TLS for SMTP
KC_SPI_SMTP_SSL=false

# Reply-to address for emails
KC_SPI_SMTP_REPLY_TO=support@example.com

# =================================================================================
# THEMES & CUSTOMIZATION
# =================================================================================

# Theme for login pages
KC_LOGIN_THEME=keycloak

# Theme for admin console
KC_ADMIN_THEME=keycloak

# Theme for account management
KC_ACCOUNT_THEME=keycloak

# Theme for email templates
KC_EMAIL_THEME=keycloak

# Internationalization (i18n) enabled
KC_I18N_ENABLED=true

# Default locale
KC_I18N_DEFAULT_LOCALE=en

# =================================================================================
# METRICS & MONITORING
# =================================================================================

# Enable metrics endpoint (/metrics)
KC_METRICS_ENABLED=true

# JMX monitoring port
KEYCLOAK_JMX_PORT=9999

# =================================================================================
# JMX SECURITY CONFIGURATION
# =================================================================================

# Enable secure JMX (authentication + SSL) - true for production, false for development only
JMX_SECURE=true

# Keystore password for JMX SSL
KEYSTORE_PASSWORD=changeit

# Truststore password for JMX SSL
TRUSTSTORE_PASSWORD=changeit

# =================================================================================
# IMPORT/EXPORT CONFIGURATION
# =================================================================================

# Import realm from file on startup (absolute path)
# KC_IMPORT=/opt/keycloak/data/realm.json

# Import action: create, update, skip
# KC_IMPORT_ACTION=create

# =================================================================================
# PERFORMANCE TUNING
# =================================================================================

# Enable health checks endpoints
KC_HEALTH_ENABLED=true

# Enable metrics collection
KC_METRICS_ENABLED=true

# Database connection pool size
KC_DB_POOL_INITIAL_SIZE=10

# Database connection pool max size
KC_DB_POOL_MAX_SIZE=30

# Database connection pool min idle connections
KC_DB_POOL_MIN_IDLE=5

# Database connection pool max lifetime (milliseconds)
KC_DB_POOL_MAX_LIFE_TIME=600000

# Transaction timeout (seconds)
KC_TRANSACTION_TIMEOUT=300

# =================================================================================
# SECURITY CONFIGURATION
# =================================================================================

# Enable/disable X-Frame-Options header
KC_X_FRAME_OPTIONS=SAMEORIGIN

# Enable/disable X-Content-Type-Options header (nosniff recommended)
KC_X_CONTENT_TYPE_OPTIONS=nosniff

# Enable/disable X-XSS-Protection header
KC_X_XSS_PROTECTION=1; mode=block

# Content Security Policy header
KC_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';

# CORS allowed origins (comma-separated)
KC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =================================================================================
# NOTES FOR PRODUCTION
# =================================================================================
# 1. Change KEYCLOAK_ADMIN_PASSWORD to a strong password
# 2. Set JMX_SECURE=true and use strong KEYSTORE_PASSWORD/TRUSTSTORE_PASSWORD
# 3. Configure KC_HTTPS_* for HTTPS (especially in production)
# 4. Set up SMTP configuration for email functionality
# 5. Configure KC_CORS_ALLOWED_ORIGINS for your frontend domains
# 6. Consider using a centralized secrets management solution
# 7. Monitor KC_LOG_LEVEL=WARN or lower in production
# 8. Adjust memory (JAVA_OPTS_APPEND) based on your user load
# 9. Use hosted certificates or Let's Encrypt for KC_HTTPS_*
# 10. Set KC_PROXY=edge if behind a reverse proxy (Nginx, HAProxy, AWS ALB)
